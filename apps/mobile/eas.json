{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
      "development": {
        "developmentClient": true,
        "distribution": "internal",
        "credentialsSource": "local",
        "env": {
          "EXPO_PUBLIC_ENABLE_QUICK_LOGIN": "true"
        },
        "android": {
          "buildType": "apk"
        }
      },
      "preview": {
        "distribution": "internal",
        "credentialsSource": "local",
        "env": {
          "EXPO_PUBLIC_ENABLE_QUICK_LOGIN": "true"
        },
        "android": {
          "buildType": "apk"
        }
      },
      "production": {
        "env": {
          "EXPO_PUBLIC_ENABLE_QUICK_LOGIN": "true"
        },
        "android": {
          "buildType": "app-bundle"
        }
      }
  }
}
