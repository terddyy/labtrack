{
  "expo": {
    "name": "LABTRACK",
    "slug": "labtrack",
    "scheme": "labtrack",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/brand/labtrack-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/brand/labtrack-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F7F8"
    },
    "android": {
      "package": "edu.psu.ccs.labtrack",
      "versionCode": 5,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/labtrack-adaptive-foreground.png",
        "backgroundColor": "#F4F7F8"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow LABTRACK to scan equipment QR codes.",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow LABTRACK to take photos for defect reports.",
          "photosPermission": "Allow LABTRACK to attach photos to defect reports.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#236A91"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e6f2e3dd-5ea1-4ed4-9fce-b70672ccc2fd"
      }
    },
    "owner": "terddy0703"
  }
}
